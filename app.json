{
  "expo": {
    "name": "FlashFits-Merchant-App",
    "slug": "FlashFits-Merchant-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flashfitsmerchantapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shubhamexpo7.FlashFitsMerchantApp",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "FlashFits needs camera access to capture product photos and order packing proof images.",
        "NSPhotoLibraryUsageDescription": "FlashFits needs photo library access to upload product pictures, store branding, and KYC documents.",
        "NSPhotoLibraryAddUsageDescription": "FlashFits needs permission to save photos to your photo library.",
        "NSLocationWhenInUseUsageDescription": "FlashFits uses store location to verify shop address and optimize delivery rider pickup."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.shubhamexpo7.FlashFitsMerchantApp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FlashFits to access camera for product photos and packing proofs."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FlashFits to access photos for product catalog and verification documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FlashFits to access store location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#208AEF"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afb120d4-1db6-48f5-acf0-bdb195b2efd8"
      }
    }
  }
}
